{
  "openapi": "3.0.0",
  "info": {
    "title": "Odyssey Ops API",
    "version": "0.1.0",
    "description": "Restaurant ordering API. Totals and status transitions are server-owned."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Local wrangler"
    }
  ],
  "components": {
    "schemas": {
      "MenuTree": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuCategoryWithItems"
        }
      },
      "MenuCategoryWithItems": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MenuCategory"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "available": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "available",
          "createdAt",
          "updatedAt"
        ]
      },
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "MenuCategoryCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "required": [
          "name"
        ]
      },
      "MenuItemWithCategory": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MenuItem"
          },
          {
            "type": "object",
            "properties": {
              "categoryName": {
                "type": "string"
              }
            },
            "required": [
              "categoryName"
            ]
          }
        ]
      },
      "MenuItemCreate": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ]
      },
      "MenuItemPatch": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderListItem"
            }
          },
          "total": {
            "type": "integer"
          },
          "openCount": {
            "type": "integer"
          },
          "completedCount": {
            "type": "integer"
          },
          "cancelledCount": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "openCount",
          "completedCount",
          "cancelledCount"
        ]
      },
      "OrderListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway",
              "delivery"
            ]
          },
          "totalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "itemCount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "reference",
          "status",
          "channel",
          "totalCents",
          "createdAt",
          "customerName",
          "itemCount"
        ]
      },
      "OrderChannel": {
        "type": "string",
        "enum": [
          "dine_in",
          "takeaway",
          "delivery"
        ]
      },
      "OrderDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "customerName": {
                "type": "string"
              },
              "customerEmail": {
                "type": "string"
              },
              "allowedActions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderAction"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "menuItemId": {
                      "type": "string"
                    },
                    "nameSnapshot": {
                      "type": "string"
                    },
                    "unitPriceCents": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "lineTotalCents": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "id",
                    "menuItemId",
                    "nameSnapshot",
                    "unitPriceCents",
                    "quantity",
                    "lineTotalCents"
                  ]
                }
              }
            },
            "required": [
              "customerName",
              "customerEmail",
              "allowedActions",
              "items"
            ]
          }
        ]
      },
      "OrderAction": {
        "type": "string",
        "enum": [
          "accept",
          "start_preparing",
          "mark_ready",
          "complete",
          "cancel"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway",
              "delivery"
            ]
          },
          "subtotalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "taxCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "totalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "customerId",
          "status",
          "channel",
          "subtotalCents",
          "taxCents",
          "totalCents",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": [
              "name",
              "email"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/OrderChannel"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItem"
            },
            "minItems": 1
          }
        },
        "required": [
          "channel",
          "items"
        ]
      },
      "CreateOrderItem": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "OrderActionRequest": {
        "type": "object",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/OrderAction"
          }
        },
        "required": [
          "action"
        ]
      },
      "CustomerList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerListItem"
            }
          },
          "total": {
            "type": "integer"
          },
          "lifetimeSpendCents": {
            "type": "integer"
          },
          "repeatRate": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "lifetimeSpendCents",
          "repeatRate"
        ]
      },
      "CustomerListItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Customer"
          },
          {
            "type": "object",
            "properties": {
              "orderCount": {
                "type": "integer"
              },
              "lifetimeSpendCents": {
                "type": "integer"
              },
              "lastOrderAt": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "orderCount",
              "lifetimeSpendCents",
              "lastOrderAt"
            ]
          }
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "createdAt"
        ]
      },
      "CustomerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerListItem"
          },
          {
            "type": "object",
            "properties": {
              "recentOrders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderListItem"
                }
              }
            },
            "required": [
              "recentOrders"
            ]
          }
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "autoAccept": {
            "type": "boolean"
          },
          "serviceOpen": {
            "type": "boolean"
          },
          "acceptDineIn": {
            "type": "boolean"
          },
          "acceptTakeaway": {
            "type": "boolean"
          },
          "acceptDelivery": {
            "type": "boolean"
          },
          "opensAt": {
            "type": "string"
          },
          "closesAt": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "taxRateBps": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "nextOrderNumber": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prepTimeMinutes",
          "autoAccept",
          "serviceOpen",
          "acceptDineIn",
          "acceptTakeaway",
          "acceptDelivery",
          "opensAt",
          "closesAt",
          "timezone",
          "taxRateBps",
          "nextOrderNumber",
          "updatedAt"
        ]
      },
      "SettingsPatch": {
        "type": "object",
        "properties": {
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "autoAccept": {
            "type": "boolean"
          },
          "serviceOpen": {
            "type": "boolean"
          },
          "acceptDineIn": {
            "type": "boolean"
          },
          "acceptTakeaway": {
            "type": "boolean"
          },
          "acceptDelivery": {
            "type": "boolean"
          },
          "opensAt": {
            "type": "string"
          },
          "closesAt": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "taxRateBps": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "ordersToday": {
            "type": "integer"
          },
          "revenueCents": {
            "type": "integer"
          },
          "openOrders": {
            "type": "integer"
          },
          "averageOrderCents": {
            "type": "integer"
          },
          "popularItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PopularItem"
            }
          },
          "liveOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderListItem"
            }
          }
        },
        "required": [
          "ordersToday",
          "revenueCents",
          "openOrders",
          "averageOrderCents",
          "popularItems",
          "liveOrders"
        ]
      },
      "PopularItem": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer"
          },
          "quantitySold": {
            "type": "integer"
          }
        },
        "required": [
          "menuItemId",
          "name",
          "categoryName",
          "priceCents",
          "quantitySold"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/menu": {
      "get": {
        "tags": [
          "Menu"
        ],
        "responses": {
          "200": {
            "description": "Menu tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuTree"
                }
              }
            }
          }
        }
      }
    },
    "/menu/categories": {
      "post": {
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuCategoryCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategoryWithItems"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items": {
      "post": {
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemWithCategory"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items/{id}": {
      "patch": {
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuItemPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemWithCategory"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/OrderChannel"
            },
            "required": false,
            "name": "channel",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "search",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Order list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Order detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/actions": {
      "post": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
