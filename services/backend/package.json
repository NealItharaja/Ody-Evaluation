    "hono": "^4.13.3",
    "postgres": "^3.4.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250812.0",
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
