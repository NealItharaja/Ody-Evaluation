{
  "name": "@ody/dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "dev:native": "expo start",
    "build": "expo export --platform web --output-dir dist",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check app src",
    "clean": "rimraf .turbo .expo dist node_modules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@ody/api-client": "workspace:*",
    "@ody/shared": "workspace:*",
    "@ody/types": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}
